<form class="pv-wall-quick">
  <fieldset>
    <legend>PF2E Visioner</legend>
    <div class="form-group">
      <label>{{localize "PF2E_VISIONER.UI.WALL_BLOCKS_SCENT"}}</label>
      <input type="checkbox" name="blocksScent" {{checked blocksScent}} />
      <p class="notes">{{localize "PF2E_VISIONER.UI.WALL_BLOCKS_SCENT_HINT"}}</p>
    </div>
    {{#if isDoor}}
    <section class="pv-peek-settings">
      <h3>{{localize "PF2E_VISIONER.PEEK.DOOR_SETTINGS_TITLE"}}</h3>
      <div class="pv-peek-field pv-peek-toggle">
        <label for="pv-peek-allowed">{{localize "PF2E_VISIONER.PEEK.ALLOW_FIELD_LABEL"}}</label>
        <input id="pv-peek-allowed" type="checkbox" name="peekAllowed" {{checked peekAllowed}} />
      </div>
      <div class="pv-peek-options" {{#unless peekAllowed}}hidden{{/unless}}>
      <div class="pv-peek-field">
        <label for="pv-peek-dc">{{localize "PF2E_VISIONER.PEEK.DC_FIELD_LABEL"}}</label>
        <input id="pv-peek-dc" type="number" name="peekDC" value="{{peekDC}}" min="0" step="1" />
      </div>
      <div class="pv-peek-field">
        <label for="pv-peek-slit">{{localize "PF2E_VISIONER.SETTINGS.PEEK_SLIT_ANGLE.name"}}</label>
        <input id="pv-peek-slit" type="number" name="peekSlitAngle" value="{{peekSlitAngle}}" min="0.01" step="any" required />
        <p class="notes">{{localize "PF2E_VISIONER.SETTINGS.PEEK_SLIT_ANGLE.hint"}}</p>
      </div>
      <div class="pv-peek-field">
        <label for="pv-peek-sweep">{{localize "PF2E_VISIONER.SETTINGS.PEEK_SWEEP_ANGLE.name"}}</label>
        <input id="pv-peek-sweep" type="number" name="peekSweepAngle" value="{{peekSweepAngle}}" min="0" step="any" required />
        <p class="notes">{{localize "PF2E_VISIONER.SETTINGS.PEEK_SWEEP_ANGLE.hint"}}</p>
      </div>
      <div class="pv-peek-field">
        <label for="pv-peek-range">{{localize "PF2E_VISIONER.SETTINGS.PEEK_RANGE.name"}}</label>
        <input id="pv-peek-range" type="number" name="peekRange" value="{{peekRange}}" min="0" step="any" required />
        <p class="notes">{{localize "PF2E_VISIONER.SETTINGS.PEEK_RANGE.hint"}}</p>
      </div>
      </div>
    </section>
    {{/if}}
    <div class="form-group">
      <label>{{localize "PF2E_VISIONER.UI.COVER_LABEL"}}</label>
  <div class="cover-override-buttons pv-u-flex pv-u-gap-4" style="margin-top:4px;">
        <button type="button" class="visioner-icon-btn {{#unless coverOverride}}active{{/unless}}" 
                data-cover-override="auto" data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_COVER_AUTO_TOOLTIP'}}">
          <i class="fas fa-bolt-auto icon-color-gray"></i>
        </button>
        <button type="button" class="visioner-icon-btn {{#if (eq coverOverride 'none')}}active{{/if}}" 
                data-cover-override="none" data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_COVER_NONE_TOOLTIP'}}">
          <i class="fas fa-shield-slash icon-color-cover-none"></i>
        </button>
        <button type="button" class="visioner-icon-btn {{#if (eq coverOverride 'lesser')}}active{{/if}}" 
                data-cover-override="lesser" data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_COVER_LESSER_TOOLTIP'}}">
          <i class="fa-regular fa-shield icon-color-cover-lesser"></i>
        </button>
        <button type="button" class="visioner-icon-btn {{#if (eq coverOverride 'standard')}}active{{/if}}" 
                data-cover-override="standard" data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_COVER_STANDARD_TOOLTIP'}}">
          <i class="fas fa-shield-alt icon-color-cover-standard"></i>
        </button>
        <button type="button" class="visioner-icon-btn {{#if (eq coverOverride 'greater')}}active{{/if}}" 
                data-cover-override="greater" data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_COVER_GREATER_TOOLTIP'}}">
          <i class="fas fa-shield icon-color-cover-greater"></i>
        </button>
      </div>
      <input type="hidden" name="coverOverride" value="{{coverOverride}}">
      <p class="notes">Set how this wall provides cover in combat.</p>
    </div>
    {{#if hiddenWallsEnabled}}
    <div class="form-group">
      <label>{{localize "PF2E_VISIONER.UI.HIDDEN_WALL_LABEL"}}</label>
      <input type="checkbox" name="hiddenWall" {{#if hiddenWall}}checked{{/if}} data-tooltip="{{localize 'PF2E_VISIONER.UI.WALL_HIDDEN_TOOLTIP'}}"
        data-trigger-change="hidden-wall-sections" />
      <p class="notes">Adds a visible indicator for players;</p>
    </div>
  <div class="form-group hidden-wall-section {{#unless hiddenWall}}is-hidden{{/unless}}">
      <label>{{localize "PF2E_VISIONER.UI.WALL_IDENTIFIER_LABEL"}}</label>
      <input type="text" name="identifier" value="{{identifier}}" />
      <p class="notes">Shown in the Token Manager for observers.</p>
    </div>
  <div class="form-group hidden-wall-section {{#unless hiddenWall}}is-hidden{{/unless}}">
      <label>{{localize "PF2E_VISIONER.UI.WALL_STEALTH_DC_LABEL"}}</label>
      <input type="number" name="dc" min="0" step="1" value="{{dc}}" />
      <p class="notes">Optional per-wall DC for Seek; blank uses default setting.</p>
    </div>
  <div class="form-group hidden-wall-section {{#unless hiddenWall}}is-hidden{{/unless}}">
      <label>Connected Walls (Identifiers)</label>
      <input type="text" name="connected" value="{{connectedCsv}}" placeholder="{{localize 'PF2E_VISIONER.UI.CONNECTED_IDENTIFIERS_PLACEHOLDER'}}" />
      <p class="notes">List identifiers of other walls linked to this one. Actions that affect this wall will also apply
        to those walls.</p>
    </div>
    {{/if}}
  </fieldset>
  <footer class="sheet-footer pv-u-flex pv-u-gap-8 pv-u-justify-end">
    <button type="button" data-action="apply" class="visioner-btn visioner-primary"><i class="fas fa-check"></i>
      Apply</button>
    <button type="button" data-action="close" class="visioner-btn"><i class="fas fa-times"></i> Close</button>
  </footer>
</form>

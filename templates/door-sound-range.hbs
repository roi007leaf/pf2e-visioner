<section class="pv-sound-range" data-range data-direction="{{direction}}" data-index="{{index}}" style="--clip-color:{{color}}">
  <div class="pv-sound-clip-main">
    <span class="pv-sound-clip-number">{{number}}</span>
    <div class="pv-sound-range-bounds"><input aria-label="From angle" type="number" data-field="from" value="{{from}}" min="0" max="90" step="1"><span>→</span><input aria-label="To angle" type="number" data-field="to" value="{{to}}" min="0" max="90" step="1"><span>°</span></div>
    <file-picker type="audio" data-field="src" value="{{src}}" aria-label="Audio clip"></file-picker>
    <button type="button" class="pv-sound-remove" data-action="removeRange" title="Remove range" aria-label="Remove range"><i class="fas fa-trash"></i></button>
  </div>
  <div class="pv-sound-clip-options">
    <details><summary><i class="fas fa-sliders"></i> Trim</summary><div class="pv-sound-trim"><label>Start (s)<input type="number" data-field="start" value="{{start}}" min="0" step="0.1"></label><label>End (s)<input type="number" data-field="end" value="{{end}}" min="0" step="0.1" placeholder="Full clip"></label></div></details>
    <label class="pv-sound-volume"><i class="fas fa-volume-low"></i> Volume<input aria-label="Clip volume" type="number" data-field="volume" value="{{volume}}" min="0" max="1" step="0.05"></label>
    <label class="pv-sound-loop"><i class="fas fa-repeat"></i> Loop<input type="checkbox" data-field="loop" {{checked loop}}></label>
  </div>
</section>
